---
import { NAV_LINKS, SERVICES, COMPANY, telHref } from '../lib/data';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-20 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7">
        <div class="font-display font-bold text-white text-[44px] md:text-[72px] tracking-[-0.03em] leading-[0.9] uppercase">
          Dauphin<br />Royal
        </div>
        <div class="mt-3 font-serif italic text-gold text-[20px] md:text-[26px]">— votre partenaire bureautique depuis 2006.</div>
      </div>
      <div class="md:col-span-5 md:text-right">
        <div class="mono-label text-white/60">Bangui · RCA</div>
        <p class="mt-3 text-white/55 text-[14px] leading-relaxed max-w-sm md:ml-auto">
          Centre-ville (PK0), derrière le marché central. Lun–Ven 8h–18h · Sam 8h–13h.
        </p>
      </div>
    </div>

    <hr class="rule-gold mt-12" />

    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Pages -->
      <div>
        <div class="mono-label text-white/40! mb-4">Pages</div>
        <ul class="space-y-2.5">
          {NAV_LINKS.map((l) => (
            <li><a href={`/${l.href}`} class="text-white/60 hover:text-gold text-[13px] transition-colors">{l.label}</a></li>
          ))}
          <li><a href="/demande-de-devis" class="text-white/60 hover:text-gold text-[13px] transition-colors">Demande de devis</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <div class="mono-label text-white/40! mb-4">Services</div>
        <ul class="space-y-2.5">
          {SERVICES.map((s) => (
            <li><a href="/#services" class="text-white/60 hover:text-gold text-[13px] transition-colors">{s.title}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <div class="mono-label text-white/40! mb-4">Contact</div>
        <div class="space-y-1.5">
          {COMPANY.phones.map((p) => (
            <a href={telHref(p)} class="block text-white/60 hover:text-gold text-[13px]">{p}</a>
          ))}
          <a href={`mailto:${COMPANY.emailPapeterie}`} class="block text-white/60 hover:text-gold text-[13px] break-all">{COMPANY.emailPapeterie}</a>
          <a href={`mailto:${COMPANY.emailImprimerie}`} class="block text-white/60 hover:text-gold text-[13px] break-all">{COMPANY.emailImprimerie}</a>
        </div>
      </div>

      <!-- Adresse -->
      <div>
        <div class="mono-label text-white/40! mb-4">Adresse</div>
        <p class="text-white/60 text-[13px] leading-relaxed">
          Centre-ville (PK0)<br />derrière le marché central<br />Bangui, République centrafricaine
        </p>
      </div>
    </div>

    <div class="mt-16 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[12px] text-white/30 font-mono uppercase tracking-[0.12em]">
      <div>© {year} Dauphin Royal · Tous droits réservés</div>
      <div><a href="https://www.blanchemind.com" target="_blank" class="text-white/60 hover:text-gold transition-colors">Realisé par Blanche Mind</a></div>
    </div>
  </div>
</footer>
