---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { COMPANY, telHref } from '../lib/data';
---
<section id="contact" class="bg-navy text-white">
  <div class="grid lg:grid-cols-2">
    <div class="px-6 md:px-12 lg:px-16 py-16 md:py-20 lg:py-24 reveal">
      <div class="mono-label text-white/55!">// Coordonnées</div>
      <h2 class="mt-5 font-display font-bold text-white text-[32px] sm:text-[42px] lg:text-[48px] leading-[1.02] tracking-tight">
        Parlons de votre<br />
        <span class="font-serif italic font-normal text-gold">projet bureautique.</span>
      </h2>

      <div class="mt-10 space-y-5 max-w-md">
        <div class="border-l-2 border-gold pl-5 py-1">
          <div class="font-mono text-[10px] uppercase tracking-mono text-white/55 mb-1.5">Téléphone</div>
          <div class="text-white text-[15px] leading-relaxed">
            {COMPANY.phones.map((p) => (
              <a href={telHref(p)} class="block hover:text-gold transition-colors">{p}</a>
            ))}
          </div>
        </div>
        <div class="border-l-2 border-gold pl-5 py-1">
          <div class="font-mono text-[10px] uppercase tracking-mono text-white/55 mb-1.5">E-mail · Imprimerie</div>
          <div class="text-white text-[15px] leading-relaxed">
            <a href={`mailto:${COMPANY.emailImprimerie}`} class="block hover:text-gold transition-colors break-all">{COMPANY.emailImprimerie}</a>
          </div>
        </div>
        <div class="border-l-2 border-gold pl-5 py-1">
          <div class="font-mono text-[10px] uppercase tracking-mono text-white/55 mb-1.5">E-mail · Papeterie</div>
          <div class="text-white text-[15px] leading-relaxed">
            <a href={`mailto:${COMPANY.emailPapeterie}`} class="block hover:text-gold transition-colors break-all">{COMPANY.emailPapeterie}</a>
          </div>
        </div>
        <div class="border-l-2 border-gold pl-5 py-1">
          <div class="font-mono text-[10px] uppercase tracking-mono text-white/55 mb-1.5">Adresse</div>
          <div class="text-white text-[15px] leading-relaxed"><span class="block">{COMPANY.address}</span></div>
        </div>
        <div class="border-l-2 border-gold pl-5 py-1">
          <div class="font-mono text-[10px] uppercase tracking-mono text-white/55 mb-1.5">Horaires</div>
          <div class="text-white text-[15px] leading-relaxed"><span class="block">Lun–Ven 8h–18h · Sam 8h–13h</span></div>
        </div>
      </div>
    </div>

    <div class="bg-ink text-white px-6 md:px-12 lg:px-16 py-16 md:py-20 lg:py-24 flex flex-col justify-center reveal reveal-d2 relative">
      <div class="hidden md:block absolute top-6 right-6 font-mono text-[10px] uppercase tracking-mono text-white/30">
        §03 · Démarrer
      </div>

      <div class="mono-label text-gold!">// Démarrer maintenant</div>
      <h2 class="mt-5 font-display font-bold text-white text-[32px] sm:text-[40px] lg:text-[44px] leading-[1.05] tracking-tight max-w-md">
        Prêt à équiper<br />
        <span class="font-serif italic font-normal text-gold">votre entreprise ?</span>
      </h2>
      <p class="mt-5 text-white/65 text-[15px] leading-relaxed max-w-md">
        Décrivez-nous vos besoins. Un chargé de compte vous rappelle gratuitement sous 24 heures avec une proposition adaptée à votre budget et vos délais.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/demande-de-devis"
          class="inline-flex items-center gap-2 h-12 px-6 bg-gold text-ink text-[12px] font-semibold uppercase tracking-widest border border-gold hover:bg-white hover:border-white transition-colors">
          Demander un devis →
        </a>
        <a href={COMPANY.whatsapp} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 h-12 px-6 bg-whatsapp text-white border border-whatsapp text-[12px] font-semibold uppercase tracking-widest hover:bg-whatsapp-deep hover:border-whatsapp-deep transition-colors">
          <WhatsAppIcon mono class="text-white" />
          WhatsApp
        </a>
      </div>
      <div class="mt-10 pt-6 border-t border-white/10 flex items-center gap-4 text-white/55 font-mono text-[10px] uppercase tracking-widest">
        <span class="text-gold">●</span>
        <span>Réponse moyenne&nbsp;: 4 heures ouvrées</span>
      </div>
    </div>
  </div>
</section>
