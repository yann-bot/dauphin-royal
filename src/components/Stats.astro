---
import { STATS } from '../lib/data';

// Per-index borders replicating the prototype's 2-col → 4-col divider logic.
const borders = (i: number) => [
  i < 3 ? 'lg:border-r' : '',
  i % 2 === 0 ? 'border-r lg:border-r' : '',
  i < 2 ? 'border-b lg:border-b-0' : '',
  'border-white/10',
].filter(Boolean).join(' ');
---
<section id="apropos" class="bg-ink text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="py-8 flex flex-wrap items-baseline justify-between gap-4 border-b border-white/10">
      <div class="mono-label text-gold!">// Indicateurs clés · 2025</div>
      <span class="font-mono text-[10px] uppercase tracking-mono text-white/40">Sources internes</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {STATS.map((s, i) => (
        <div class={`py-12 md:py-16 px-2 md:px-6 reveal reveal-d${(i % 4) + 1} ${borders(i)}`}>
          <div class="font-mono font-medium text-gold text-[48px] sm:text-[60px] lg:text-[72px] leading-[0.95] tracking-[-0.03em] flex items-baseline">
            <span class="count-up" data-count-to={s.raw} data-count-group={s.value.includes(' ') ? '1' : '0'}>0</span>
            {s.suffix && <span class="text-gold/80 text-[60%] ml-0.5">{s.suffix}</span>}
          </div>
          <div class="mt-4 font-mono text-[11px] uppercase tracking-mono text-white/65">{s.label}</div>
          <div class="mt-1 font-serif italic text-white/40 text-[14px]">{s.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animated count-up when each number scrolls into view.
  const fmt = (n: number, group: boolean) =>
    group ? n.toLocaleString('fr-FR').replace(/ |,/g, ' ') : String(n);

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo || '0');
    const group = el.dataset.countGroup === '1';
    const duration = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt(Math.round(target * eased), group);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const nums = document.querySelectorAll<HTMLElement>('.count-up');
  if (!('IntersectionObserver' in window)) {
    nums.forEach((el) => animate(el));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { animate(e.target as HTMLElement); io.unobserve(e.target); }
      });
    }, { threshold: 0.3 });
    nums.forEach((el) => io.observe(el));
  }
</script>
