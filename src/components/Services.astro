---
import { SERVICES } from '../lib/data';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="services" class="bg-white border-t border-rule">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-20 md:py-28">
    <div class="grid grid-cols-12 gap-6 mb-14">
      <div class="col-span-12 md:col-span-8 reveal">
        <div class="mono-label">// Services · 04 domaines</div>
        <h2 class="mt-5 font-display font-bold text-ink text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.02] tracking-[-0.03em]">
          Nos domaines<br />
          <span class="font-serif italic font-normal text-muted">d'expertise.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-4 reveal reveal-d2 md:pl-8 md:border-l md:border-rule">
        <p class="text-muted text-[15px] leading-relaxed">
          Quatre métiers complémentaires, un interlocuteur unique, du devis à la livraison. Notre force&nbsp;: tout couvrir, sous un même standard d'exécution.
        </p>
      </div>
    </div>

    <div>
      <hr class="rule" />
      {SERVICES.map((s, i) => (
        <>
          <a href="#contact" class="svc-row group block reveal">
            <div class="grid grid-cols-12 gap-4 md:gap-6 items-center py-9 md:py-12 px-2 md:px-4 transition-colors duration-200 group-hover:bg-surface relative">
              <div class="col-span-12 md:col-span-2">
                <div class="font-display font-light text-rule-strong group-hover:text-ink text-[60px] md:text-[72px] leading-none tracking-tight transition-colors">
                  {pad(i + 1)}
                </div>
              </div>
              <div class="col-span-12 md:col-span-4">
                <h3 class="font-display font-bold text-ink text-[24px] md:text-[28px] tracking-[-0.02em] leading-tight">
                  {s.title}
                </h3>
                <p class="mt-3 text-muted text-[14.5px] leading-relaxed max-w-md">{s.description}</p>
              </div>
              <div class="col-span-12 md:col-span-5 flex flex-wrap gap-2">
                {s.tags.map((t) => (
                  <span class="inline-flex items-center px-3 h-7 text-[11px] font-medium text-muted uppercase tracking-[0.06em] border border-rule bg-white group-hover:border-ink group-hover:text-ink transition-colors">
                    {t}
                  </span>
                ))}
              </div>
              <div class="hidden md:flex col-span-1 justify-end">
                <span class="font-mono text-[13px] text-ink transition-transform duration-200 group-hover:translate-x-1.5">Voir →</span>
              </div>

              <img src={s.image} alt="" aria-hidden="true" class="svc-thumb hidden lg:block" />
            </div>
          </a>
          <hr class="rule" />
        </>
      ))}
    </div>
  </div>
</section>
