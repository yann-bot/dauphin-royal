---
import { WHY_US, TESTIMONIALS, WHY_IMAGE } from '../lib/data';
---
<section class="bg-white border-t border-rule">
  <div class="grid lg:grid-cols-2 border-b border-rule">
    <div class="bg-white px-6 md:px-12 lg:px-16 py-16 md:py-24 lg:border-r border-rule">
      <div class="max-w-xl reveal">
        <div class="mono-label">// Pourquoi nous choisir</div>
        <h2 class="mt-5 font-display font-bold text-ink text-[36px] sm:text-[46px] lg:text-[52px] leading-[1.02] tracking-[-0.03em]">
          Pourquoi <span class="font-serif italic font-normal text-muted">Dauphin Royal</span> ?
        </h2>
        <div class="mt-10 space-y-9">
          {WHY_US.map((w) => (
            <div class="grid grid-cols-12 gap-5 reveal reveal-d1">
              <div class="col-span-2 font-mono text-gold text-[14px] tracking-mono pt-1">{w.num}</div>
              <div class="col-span-10">
                <h3 class="font-display font-bold text-ink text-[19px] tracking-tight">{w.title}</h3>
                <p class="mt-2 text-muted text-[14.5px] leading-relaxed">{w.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bg-surface relative min-h-[420px] lg:min-h-0 reveal reveal-d2">
      <img src={WHY_IMAGE} alt="Équipe Dauphin Royal" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      <div class="absolute top-5 left-5 bg-white px-3 py-2">
        <div class="font-mono text-[10px] uppercase tracking-mono text-ink">FIG. 02 · Équipe</div>
      </div>
      <div class="absolute bottom-0 inset-x-0 bg-ink/85 backdrop-blur-sm px-6 py-5 flex items-baseline justify-between gap-4">
        <div class="font-serif italic text-white text-[18px] sm:text-[22px] leading-tight">« Un standard, partout, tout le temps. »</div>
        <div class="font-mono text-[10px] uppercase tracking-mono text-gold whitespace-nowrap">D.R. · 2026</div>
      </div>
    </div>
  </div>

  <!-- Testimonials -->
  <div class="max-w-[1280px] mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="grid grid-cols-12 gap-6 reveal">
      <div class="col-span-12 md:col-span-7">
        <div class="mono-label">// Témoignages clients</div>
        <h2 class="mt-5 font-display font-bold text-ink text-[32px] sm:text-[40px] lg:text-[46px] leading-[1.05] tracking-[-0.025em]">
          La parole<br />
          <span class="font-serif italic font-normal text-muted">à nos clients.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5 md:pl-8 md:border-l md:border-rule md:flex md:items-end">
        <p class="text-muted text-[14.5px] leading-relaxed">
          Banques, ministères, ONG, industries&nbsp;: trois témoignages parmi plus de 500 partenaires actifs en RCA.
        </p>
      </div>
    </div>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3">
      {TESTIMONIALS.map((t, i) => (
        <figure class:list={[
          `reveal reveal-d${i + 1} pr-0 md:pr-10 pl-0 md:pl-10 first:md:pl-0 last:md:pr-0 py-6 md:py-2`,
          i < TESTIMONIALS.length - 1 ? 'border-b md:border-b-0 md:border-r border-rule' : '',
        ]}>
          <div class="font-serif italic text-gold text-[44px] leading-none">"</div>
          <blockquote class="mt-2 text-ink text-[16.5px] leading-[1.55] font-medium">
            {t.quote}
          </blockquote>
          <div class="mt-6 h-px bg-gold w-12"></div>
          <figcaption class="mt-5">
            <div class="font-display font-bold text-ink text-[14px] tracking-tight">{t.author}</div>
            <div class="text-muted text-[12px] mt-1">{t.role} · {t.company}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
