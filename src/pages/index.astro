---
import Layout      from '../layouts/Layout.astro';
import Nav         from '../components/Nav.astro';
import Hero        from '../components/Hero.astro';
import SectorsBand from '../components/SectorsBand.astro';
import Stats       from '../components/Stats.astro';
import Manifesto   from '../components/Manifesto.astro';
import Services    from '../components/Services.astro';
import Products    from '../components/Products.astro';
import WhyUs       from '../components/WhyUs.astro';
import Contact     from '../components/Contact.astro';
import Footer      from '../components/Footer.astro';
---

<Layout
  title="Dauphin Royal — Édition 2026 · Le partenaire bureautique des leaders en RCA"
  description="Dauphin Royal — Leader des fournitures de bureau en République centrafricaine depuis 2006. Mobilier, équipements informatiques, imprimerie et papeterie à Bangui."
>
  <Nav />
  <main>
    <Hero />
    <SectorsBand />
    <Stats />
    <Manifesto />
    <Services />
    <Products />
    <WhyUs />
    <Contact />
  </main>
  <Footer />
</Layout>
