---
import '../styles/global.css';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  url?:         string;
  noindex?:     boolean;
}

const {
  title       = 'Dauphin Royal — Fournitures de Bureau & Imprimerie à Bangui',
  description = 'Dauphin Royal est le leader des fournitures de bureau, équipements informatiques et imprimerie en République Centrafricaine depuis 2006. Qualité et service à Bangui.',
  image       = 'https://dauphinroyal.com/og-image.jpg',
  url         = 'https://dauphinroyal.com',
  noindex     = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://dauphinroyal.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'LocalBusiness',
  'name':     'Dauphin Royal',
  'description': description,
  'url':      'https://dauphinroyal.com',
  'logo':     'https://dauphinroyal.com/logo-color.png',
  'image':    image,
  'telephone':['+23675831313', '+23672308080'],
  'email':    'info.papeterie@dauphinroyal.com',
  'address': {
    '@type':           'PostalAddress',
    'streetAddress':   'Centre-ville (PK0) derrière le marché central',
    'addressLocality': 'Bangui',
    'addressCountry':  'CF',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude':  4.3947,
    'longitude': 18.5582,
  },
  'openingHoursSpecification': [{
    '@type':     'OpeningHoursSpecification',
    'dayOfWeek': ['Monday','Tuesday','Wednesday','Thursday','Friday'],
    'opens':     '08:00',
    'closes':    '18:00',
  },{
    '@type':     'OpeningHoursSpecification',
    'dayOfWeek': 'Saturday',
    'opens':     '09:00',
    'closes':    '15:00',
  }],
  'sameAs': [
    'https://www.facebook.com/dauphinroyal',
  ],
  'foundingDate': '2006',
  'numberOfEmployees': { '@type': 'QuantitativeValue', 'value': 80 },
  'areaServed': 'République Centrafricaine',
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <!-- SEO primaire — fix CRITIQUE du noindex -->
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'}/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>

  <!-- Open Graph — fix CRITIQUE du cahier des charges -->
  <meta property="og:type"        content="website"/>
  <meta property="og:url"         content={canonical}/>
  <meta property="og:title"       content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image"       content={image}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height"content="630"/>
  <meta property="og:locale"      content="fr_CF"/>
  <meta property="og:site_name"   content="Dauphin Royal"/>

  <!-- Twitter Card -->
  <meta name="twitter:card"       content="summary_large_image"/>
  <meta name="twitter:title"      content={title}/>
  <meta name="twitter:description"content={description}/>
  <meta name="twitter:image"      content={image}/>

  <!-- Favicon -->
  <link rel="icon"             href="/favicon.png" type="image/png"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>

  <!-- Fonts — Editorial v2 type system -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
</head>
<body class="bg-white text-ink font-body">
  <slot/>

  <!-- WhatsApp flottant — 52px carré, encre + bordure or -->
  <a href="https://wa.me/23675831313?text=Bonjour%20Dauphin%20Royal%2C%20j%27ai%20une%20question."
     class="wa-fab" target="_blank" rel="noopener" aria-label="Discuter sur WhatsApp">
    <WhatsAppIcon mono class="text-white" size={26} />
  </a>

  <script>
    // Scroll reveal — adds `is-visible` once an element enters the viewport.
    const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      els.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
